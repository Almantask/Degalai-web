{
  "name": "kur-degalai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free static PWA of fuel prices at every station in Lithuania",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "pipeline": "tsx scripts/pipeline.ts",
    "pipeline:osm": "tsx scripts/pipeline.ts --osm-only",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "lint": "eslint src scripts tests e2e --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:deps": "vitest run --config vitest.deps.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run i18n:check && npm run lint && npm run test && npm run typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "exceljs": "^4.4.0",
    "maplibre-gl": "^5.7.3",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/node": "^24.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.0.10",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
